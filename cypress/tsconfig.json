    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["cypress", "node"],
    "noEmit": true
  },
  "include": ["cypress.config.ts", "cypress/**/*.ts"]
}
